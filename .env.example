# Copy to .env on the server and fill in. Never commit .env.
DEBUG=False
DJANGO_SECRET_KEY=change-me-generate-with-python-c-"import secrets;print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=trendcrafters.global,www.trendcrafters.global
# Gmail app password used by the contact form
EMAIL_HOST_USER=trendcraftersglobal@gmail.com
EMAIL_HOST_PASSWORD=
# nginx terminates HTTPS and sets X-Forwarded-Proto, so leave this True in production
SECURE_SSL_REDIRECT=True
# Optional: keep the SQLite file and logs outside the code directory
# DATABASE_PATH=/var/lib/trendcrafters/db.sqlite3
# LOG_DIR=/var/log/trendcrafters
